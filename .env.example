# ----- Server -----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----- Authentication -----
# Generate a long random string, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# ----- Database -----
# If DB credentials are missing or the connection fails, FunZone automatically
# switches to its in-memory demo store so the app still runs.
DATA_STORE=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=funzone

# Optional: automatically create the database/tables on startup (needs CREATE privileges)
DB_AUTO_SETUP=false
