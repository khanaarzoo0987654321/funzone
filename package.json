{
  "name": "funzone",
  "version": "1.0.0",
  "private": true,
  "description": "FunZone - Real-Time Multiplayer Mini Games Platform",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server --ext js,json server/src/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server/src/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/tests/*.test.js",
    "test:api": "node --test server/tests/api.test.js",
    "test:games": "node --test server/tests/games.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
